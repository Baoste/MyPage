# Site and Supabase endpoint
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=

# Server-only secrets (never prefix these with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
# bcrypt hash (cost 12). Run: npm run hash-article-password
ARTICLE_PUBLISH_PASSWORD_HASH=
PRIVATE_MEDIA_SIGNED_URL_TTL_SECONDS=300

# Calendar journal AI (server-only; never prefix the key with NEXT_PUBLIC_)
CALENDAR_AI_API_KEY=
CALENDAR_AI_BASE_URL=https://api.openai.com/v1
CALENDAR_AI_TEXT_MODEL=gpt-5.4-mini
CALENDAR_AI_IMAGE_MODEL=gpt-image-2

# Public project covers. Files live at PROJECT_COVER_STORAGE_ROOT/projects/safe-name.webp.
# Windows example: C:\Users\lenovo\Pictures\MyPageData\public-assets
# Tencent Cloud CVM example: /data/mypage/public-assets
# If empty, development falls back to .data/public-assets.
PROJECT_COVER_STORAGE_ROOT=

# Article covers. Files live at ARTICLE_COVER_STORAGE_ROOT/articles/<uuid>.<ext>.
# If empty, falls back to PROJECT_COVER_STORAGE_ROOT and then .data/public-assets.
ARTICLE_COVER_STORAGE_ROOT=

# Food image files. Keep this on a persistent disk; the database stores only food/... paths.
# Windows example: C:\Users\lenovo\Pictures\MyPageData
# Tencent Cloud CVM example: /data/mypage
FOOD_STORAGE_ROOT=

# Photo image files. Can share the same persistent disk as Food.
# If empty, Photos falls back to FOOD_STORAGE_ROOT and then .data/private-media.
PHOTO_STORAGE_ROOT=
# Optional persistent directory for removable Tools module data.
# TOOLS_STORAGE_ROOT=/data/mypage/tools
